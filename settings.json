{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "BASH_DEFAULT_TIMEOUT_MS": "120000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "MAX_MCP_OUTPUT_TOKENS": "25000"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git fetch:*)",
      "Bash(pnpm:*)",
      "Bash(npm:*)",
      "Bash(yarn:*)",
      "Bash(npx eslint:*)",
      "Bash(npx jest:*)",
      "Bash(npx tsc:*)",
      "Bash(ls:*)",
      "Bash(node:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(awk:*)",
      "Bash(sed:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(diff:*)",
      "Bash(jq:*)",
      "Bash(test:*)",
      "Bash(echo:*)",
      "Bash(date:*)",
      "Bash(xargs:*)",
      "Bash(tee:*)",
      "Bash(make:*)",
      "WebSearch",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf .)",
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push -f*)",
      "Bash(git push * +*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(git checkout -- .)",
      "Bash(git restore .)",
      "Bash(git branch -D*)",
      "Bash(chmod 777*)",
      "Bash(curl * | bash)",
      "Bash(curl * | sh)",
      "Bash(curl * | zsh)",
      "Bash(curl * | python*)",
      "Bash(wget * | bash)",
      "Bash(wget * | sh)",
      "Bash(wget * | python*)",
      "Bash(eval *curl*)",
      "Bash(eval *wget*)",
      "Bash(cat ~/.ssh/*)",
      "Bash(cp ~/.ssh/*)",
      "Bash(scp ~/.ssh/*)",
      "Bash(base64 ~/.ssh/*)",
      "Bash(cat */.env*)",
      "Bash(cp */.env*)",
      "Bash(scp */.env*)",
      "Bash(base64 */.env*)",
      "Bash(cat *credentials*)",
      "Bash(cp *credentials*)",
      "Bash(scp *credentials*)",
      "Bash(base64 *credentials*)",
      "Bash(npm publish*)",
      "Bash(pnpm publish*)",
      "Edit(~/dotfiles/**)",
      "Edit(~/.claude/settings*.json)",
      "Edit(~/.claude/*.sh)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/.claude/skills/**)",
      "Edit(~/.claude/agents/**)",
      "Edit(~/.claude/commands/**)",
      "Edit(~/.claude/hooks/**)",
      "Edit(~/.claude/plugins/**)",
      "Edit(~/.claude/output-styles/**)",
      "Edit(~/.claude/workflows/**)",
      "Edit(~/.claude/dev-mods/**)",
      "Edit(~/.claude/keybindings.json)",
      "Edit(~/.claude/.credentials.json)",
      "Edit(~/.claude/shell-snapshots/**)",
      "Edit(~/.claude/session-env/**)",
      "Edit(~/.claude/local/**)",
      "Edit(~/.claude/scheduled_tasks.json)",
      "Edit(~/.claude/routines/**)",
      "Edit(~/.claude/loop.md)",
      "Edit(~/.claude/remote-settings*.json)",
      "Edit(~/.claude/policy-limits*)",
      "Edit(~/.claude/audit.log*)",
      "Edit(~/.claude/projects/*/*.jsonl)",
      "Edit(~/.claude/backups/**)",
      "Edit(~/.claude/chrome/**)",
      "Edit(~/.claude/ide/**)",
      "Edit(~/.claude/daemon/**)",
      "Edit(~/.claude/daemon.json)",
      "Edit(~/.claude/launch.json)",
      "Edit(~/.claude/cowork_plugins/**)",
      "Edit(~/.claude/mcp-skill-archives/**)",
      "Edit(~/.claude.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.local.*)",
      "Read(**/.env.development)",
      "Read(**/.env.staging)",
      "Read(**/.env.production)",
      "Read(**/.env.prod)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(claude * --dangerously-skip-permissions*)",
      "Bash(claude --dangerously-skip-permissions*)",
      "Bash(gh repo delete*)",
      "Bash(gh api -X DELETE*)",
      "Bash(gh api --method DELETE*)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git stash *)",
      "Bash(git tag *)",
      "Bash(docker stack *)",
      "Bash(docker service *)",
      "Bash(docker swarm *)",
      "Bash(docker node *)",
      "Bash(docker context *)",
      "Bash(docker push *)",
      "Bash(docker login*)",
      "Bash(docker secret *)",
      "Bash(docker config *)",
      "Bash(docker -H*)",
      "Bash(docker --host*)",
      "Bash(docker --context*)",
      "Bash(docker * --context*)",
      "Bash(docker * -H *)",
      "Bash(DOCKER_HOST=*)",
      "Bash(DOCKER_CONTEXT=*)",
      "Bash(docker * prune*)",
      "Bash(docker volume rm*)",
      "Bash(docker -c *)",
      "Bash(docker image push*)",
      "Bash(docker * --push*)",
      "Bash(docker manifest *)",
      "Bash(docker buildx imagetools *)",
      "Bash(docker compose *down*-v*)",
      "Bash(docker compose *down*--volumes*)",
      "Bash(docker rm *$(*)",
      "Bash(docker rmi *$(*)",
      "Bash(docker * --privileged*)",
      "Bash(docker * -v /:*)",
      "Bash(export DOCKER_HOST*)",
      "Bash(export DOCKER_CONTEXT*)",
      "Bash(env DOCKER_*)",
      "Bash(rm *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr create *)",
      "Bash(gh release *)",
      "Bash(gh secret *)",
      "Bash(gh variable *)"
    ],
    "defaultMode": "default"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/sessionstart.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/audit-log.sh",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "sh ~/.claude/db-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v osascript >/dev/null 2>&1; then osascript -e 'display notification \"Claude Code needs your attention\" with title \"Claude Code\"'; elif command -v notify-send >/dev/null 2>&1; then notify-send 'Claude Code' 'Claude Code needs your attention'; fi",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ~/.claude/check-secrets.sh",
            "timeout": 3
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "sh ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "figma@claude-plugins-official": true,
    "redis-development@redis": true
  },
  "extraKnownMarketplaces": {
    "redis": {
      "source": {
        "source": "git",
        "url": "https://github.com/redis/agent-skills.git"
      }
    }
  },
  "language": "Korean",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "*.github.com",
        "*.githubusercontent.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "registry.yarnpkg.com",
        "pypi.org",
        "files.pythonhosted.org",
        "*.anthropic.com",
        "*.claude.ai",
        "code.claude.com"
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.gnupg",
        "~/.netrc",
        "~/.config/gcloud",
        "~/.kube"
      ]
    }
  },
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-fable-5-1": {
      "effortLevel": "medium"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "skipWorkflowUsageWarning": true,
  "showTurnDuration": true
}
